"""Extended assembly variants: long+Hi-C, hybrid+Hi-C, or Hi-C-only.

The established short+Hi-C workflow remains in Snakefile_assembly.
MAG and MGE products share the original downstream reference pipeline.
"""
from pathlib import Path

ROOT = Path(config['root'])
UTIL = str(ROOT / 'scripts' / 'assembly_utils.py')
SAMPLE = config['sample']
THREADS = int(config['threads'])
IDENTITY_FRACTION = float(config['identity']) / 100.0
MODE = config['assembly_variant']
assert MODE in ('long_hic', 'hybrid_hic', 'hic_only'), MODE

MAG_DIR = '02_binning/{sample}_final_binset'
MGE_DIR = '05_mge_host_linking/metator_mge_{sample}'

rule all:
    input:
        expand('01_assembly/{sample}_final.contigs.fa', sample=[SAMPLE]),
        expand(MAG_DIR, sample=[SAMPLE]),
        expand(MGE_DIR, sample=[SAMPLE])

rule hic_read_qc:
    input:
        r1=config['hic_read1'],
        r2=config['hic_read2']
    output:
        r1=f'qc/{SAMPLE}_hic_clean_1.fastq',
        r2=f'qc/{SAMPLE}_hic_clean_2.fastq',
        json=f'qc/{SAMPLE}_hic.json',
        html=f'qc/{SAMPLE}_hic.html'
    threads: THREADS
    conda: 'core'
    log: f'logs/{SAMPLE}_hic_read_qc.log'
    shell:
        r"""
        mkdir -p qc logs
        fastp -i {input.r1:q} -I {input.r2:q} \
          -o {output.r1:q} -O {output.r2:q} \
          -w {threads} -D -q 30 -l 30 --cut_front --cut_tail \
          -r -M 30 -j {output.json:q} -h {output.html:q} --umi_delim / \
          > {log:q} 2>&1
        """

if MODE == 'hic_only':
    rule hicup_for_assembly:
        input:
            r1=rules.hic_read_qc.output.r1,
            r2=rules.hic_read_qc.output.r2
        output:
            r1='qc/{sample}_hic_truncated_1.fastq',
            r2='qc/{sample}_hic_truncated_2.fastq'
        params:
            outdir='qc/hicup_{sample}',
            truncater=str(ROOT / 'third_party/hicup/hicup_truncater'),
            re1='^GATC,' + config['enzyme']
        conda: 'hicup_runtime'
        threads: THREADS
        log: 'logs/{sample}_hicup_assembly.log'
        shell:
            r"""
            set -euo pipefail
            mkdir -p {params.outdir:q} logs
            perl {params.truncater:q} --r 0 --re1 {params.re1:q} --threads {threads} \
              --outdir {params.outdir:q} {input.r1:q} {input.r2:q} > {log:q} 2>&1
            mv {params.outdir:q}/{wildcards.sample}_hic_clean_1.trunc.fastq {output.r1:q}
            mv {params.outdir:q}/{wildcards.sample}_hic_clean_2.trunc.fastq {output.r2:q}
            test -s {output.r1:q} && test -s {output.r2:q}
            """

    rule assembly_final:
        input:
            r1=rules.hicup_for_assembly.output.r1,
            r2=rules.hicup_for_assembly.output.r2
        output: '01_assembly/{sample}_final.contigs.fa'
        params: outdir='01_assembly/{sample}_megahit'
        threads: THREADS
        conda: 'assembly'
        log: 'logs/{sample}_hic_only_assembly.log'
        shell:
            r"""
            set -euo pipefail
            mkdir -p 01_assembly logs
            rm -rf {params.outdir:q}
            megahit --presets meta-sensitive -t {threads} -m 0.9 \
              -1 {input.r1:q} -2 {input.r2:q} -o {params.outdir:q} > {log:q} 2>&1
            test -s {params.outdir:q}/final.contigs.fa
            cp {params.outdir:q}/final.contigs.fa {output:q}
            """

if MODE in ('long_hic', 'hybrid_hic'):
    rule long_read_assembly:
        input: config['long_reads']
        output: '01_assembly/{sample}_long.contigs.fa'
        params:
            long_type=config['long_type'],
            outdir='01_assembly/{sample}_long_assembler'
        threads: THREADS
        conda: 'long_assembly'
        log: 'logs/{sample}_long_assembly.log'
        shell:
            r"""
            set -euo pipefail
            mkdir -p 01_assembly logs
            rm -rf {params.outdir:q}
            if [[ {params.long_type:q} == nanopore ]]; then
                flye --nano-raw {input:q} --meta \
                  --out-dir {params.outdir:q} --threads {threads} > {log:q} 2>&1
                cp {params.outdir:q}/assembly.fasta {output:q}
            elif [[ {params.long_type:q} == pacbio ]]; then
                flye --pacbio-raw {input:q} --meta \
                  --out-dir {params.outdir:q} --threads {threads} > {log:q} 2>&1
                cp {params.outdir:q}/assembly.fasta {output:q}
            elif [[ {params.long_type:q} == nanoporeR10 ]]; then
                metaMDBG asm --in-ont {input:q} \
                  --out-dir {params.outdir:q} --threads {threads} > {log:q} 2>&1
                gzip -dc {params.outdir:q}/contigs.fasta.gz > {output:q}
            elif [[ {params.long_type:q} == pacbioHiFi ]]; then
                metaMDBG asm --in-hifi {input:q} \
                  --out-dir {params.outdir:q} --threads {threads} > {log:q} 2>&1
                gzip -dc {params.outdir:q}/contigs.fasta.gz > {output:q}
            else
                echo 'Unsupported long-read technology: {params.long_type}' >&2
                exit 2
            fi
            test -s {output:q}
            """

if MODE == 'hybrid_hic':
    rule short_read_qc:
        input:
            r1=config['short_read1'],
            r2=config['short_read2']
        output:
            r1=f'qc/{SAMPLE}_clean_1.fastq',
            r2=f'qc/{SAMPLE}_clean_2.fastq',
            json=f'qc/{SAMPLE}.json',
            html=f'qc/{SAMPLE}.html'
        log: f'logs/{SAMPLE}_short_read_qc.log'
        threads: THREADS
        conda: 'core'
        shell:
            r"""
            mkdir -p qc logs
            fastp -i {input.r1:q} -I {input.r2:q} \
              -o {output.r1:q} -O {output.r2:q} \
              -w {threads} -D -q 30 -l 75 --cut_front --cut_tail \
              -r -M 30 -j {output.json:q} -h {output.html:q} --umi_delim / \
              > {log:q} 2>&1
            """

if MODE == 'hybrid_hic':
    rule opera_hybrid_assembly:
        input:
            r1=rules.short_read_qc.output.r1,
            r2=rules.short_read_qc.output.r2,
            long=config['long_reads']
        output: '01_assembly/{sample}_hybrid_contigs.fa'
        params:
            opera=config['opera_ms'],
            outdir='01_assembly/{sample}_operams'
        threads: THREADS
        conda: 'opera_ms'
        log: 'logs/{sample}_opera_ms.log'
        shell:
            r"""
            set -euo pipefail
            mkdir -p 01_assembly logs
            perl {params.opera:q} \
              --short-read1 {input.r1:q} --short-read2 {input.r2:q} \
              --long-read {input.long:q} --no-ref-clustering \
              --num-processors {threads} --out-dir {params.outdir:q} > {log:q} 2>&1
            test -s {params.outdir:q}/contigs.polished.fasta
            cp {params.outdir:q}/contigs.polished.fasta {output:q}
            """

    rule assembly_final:
        input:
            hybrid=rules.opera_hybrid_assembly.output,
            long=rules.long_read_assembly.output
        output: '01_assembly/{sample}_final.contigs.fa'
        params: outdir='01_assembly/{sample}_quickmerge'
        conda: 'hybrid_tools'
        threads: THREADS
        log: 'logs/{sample}_quickmerge.log'
        shell:
            r"""
            set -euo pipefail
            mkdir -p 01_assembly logs
            rm -rf {params.outdir:q}
            mkdir -p {params.outdir:q}
            H=$(realpath {input.hybrid:q})
            L=$(realpath {input.long:q})
            O=$(realpath -m {output:q})
            LOG=$(realpath -m {log:q})
            cd {params.outdir:q}
            ln -s "$H" hybrid_contigs.fa
            ln -s "$L" long_contigs.fa
            merge_wrapper.py -l 1000 hybrid_contigs.fa long_contigs.fa > "$LOG" 2>&1
            test -s merged_out.fasta
            cp merged_out.fasta "$O"
            """

if MODE == 'long_hic':
    rule assembly_final:
        input: rules.long_read_assembly.output
        output: '01_assembly/{sample}_final.contigs.fa'
        conda: 'long_assembly'
        log: 'logs/{sample}_long_final.log'
        shell: 'cp {input:q} {output:q} && test -s {output:q}'

rule length_filtering:
    input: rules.assembly_final.output
    output: '01_assembly/{sample}_final_min2k.contigs.fa'
    conda: 'assembly'
    log: 'logs/{sample}_length_filtering.log'
    shell:
        'seqmagick convert --min-length 2000 {input:q} {output:q} > {log:q} 2>&1'

rule hic_binning:
    input:
        contigs=rules.length_filtering.output,
        r1=rules.hic_read_qc.output.r1,
        r2=rules.hic_read_qc.output.r2
    output: directory('02_binning/{sample}_final_hicbinset')
    params:
        outdir='02_binning/{sample}_metator',
        checkv_db=config['checkv_db'],
        enzyme=config['enzyme']
    threads: THREADS
    conda: 'metator'
    log: 'logs/{sample}_metator_pipeline.log'
    shell:
        r"""
        set -euo pipefail
        mkdir -p 02_binning logs
        rm -rf {params.outdir:q} {output:q}
        export CHECKVDB={params.checkv_db:q}
        metator pipeline -1 {input.r1:q} -2 {input.r2:q} -a {input.contigs:q} \
          -e {params.enzyme:q} -o {params.outdir:q} -t {threads} > {log:q} 2>&1
        test -d {params.outdir:q}/final_bin_unscaffold
        mv {params.outdir:q}/final_bin_unscaffold {output:q}
        """

if MODE == "hybrid_hic":
    rule short_binning:
        input:
            contigs=rules.length_filtering.output,
            r1=rules.short_read_qc.output.r1,
            r2=rules.short_read_qc.output.r2
        output: directory('02_binning/{sample}_final_shortbinset')
        params:
            workdir='02_binning/{sample}_basalt',
            basalt_prefix=config['basalt_prefix'],
            checkm_db=config['checkm_db'],
            conda_executable=config['conda_executable']
        threads: THREADS
        log:
            autobinning='logs/{sample}_basalt_autobinning.log',
            refinement='logs/{sample}_basalt_refinement.log'
        shell:
            r"""
            set -euo pipefail
            mkdir -p 02_binning logs
            # Keep BASALT checkpoint/intermediates across an incomplete retry; only
            # remove the declared final output so Snakemake can rebuild it safely.
            rm -rf {output:q}
            mkdir -p {params.workdir:q}
            CONTIGS=$(realpath {input.contigs:q})
            R1=$(realpath {input.r1:q})
            R2=$(realpath {input.r2:q})
            cd {params.workdir:q}
            ln -sfn "$CONTIGS" "$(basename "$CONTIGS")"
            ln -sfn "$R1" "$(basename "$R1")"
            ln -sfn "$R2" "$(basename "$R2")"
            export CHECKM_DATA_PATH={params.checkm_db:q}
            export CHECKM_DATA_DIR={params.checkm_db:q}
            # A fresh checkpoint must be initialized before the original autobinning
            # and refinement modules can be resumed in sequence.
            {params.conda_executable:q} run --no-capture-output -p {params.basalt_prefix:q} \
              BASALT -a "$(basename "$CONTIGS")" -t {threads} \
              -s "$(basename "$R1"),$(basename "$R2")" \
              --mode new --module autobinning > ../../{log.autobinning:q} 2>&1
            {params.conda_executable:q} run --no-capture-output -p {params.basalt_prefix:q} \
              BASALT -a "$(basename "$CONTIGS")" -t {threads} \
              -s "$(basename "$R1"),$(basename "$R2")" \
              --mode continue --module refinement > ../../{log.refinement:q} 2>&1
            BASALT_BINSET=$(python {UTIL:q} resolve-basalt-binset "$PWD")
            mv "$BASALT_BINSET" ../{wildcards.sample}_final_shortbinset
            test -n "$(find ../{wildcards.sample}_final_shortbinset -maxdepth 1 -type f \( -name '*.fa' -o -name '*.fasta' -o -name '*.fna' \) -print -quit)"
            """

